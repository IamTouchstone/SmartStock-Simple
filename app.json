{
  "expo": {
    "name": "SmartStock",
    "slug": "smartstock",
    "version": "1.0.1",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./public/icons/icon-512.png",
    "scheme": "smartstock",
    "updates": {
      "enabled": false
    },
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.smartstock.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./public/icons/adaptive-icon.png",
        "backgroundColor": "#0A2E24"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./public/icons/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#090D16"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SmartStock to access your camera."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9eec5173-cd3d-40f7-8d72-c5b7d988b649"
      }
    },
    "owner": "iamtouchstone"
  }
}

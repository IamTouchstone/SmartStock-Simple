{
  "expo": {
    "name": "SmartStock",
    "slug": "smartstock",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon-512.png",
    "scheme": "smartstock",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B3B2E"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "ON_ERROR_RECOVERY"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartstock.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow SmartStock to use your microphone for the voice agent.",
        "NSCameraUsageDescription": "Allow SmartStock to scan barcodes",
        "NSPhotoLibraryUsageDescription": "Allow SmartStock to access photos to read product labels"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-512.png",
        "backgroundColor": "#0B3B2E"
      },
      "package": "com.smartstock.app",
      "versionCode": 8,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/icon-192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SmartStock to access photos to read product labels"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SmartStock to scan barcodes"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow SmartStock to use your microphone for the voice agent."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon-72.png",
          "color": "#0B3B2E",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9eec5173-cd3d-40f7-8d72-c5b7d988b649"
      },
      "apiUrl": "https://smartstock-main.vercel.app"
    }
  }
}